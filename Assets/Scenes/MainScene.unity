  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\xD3timo! Voc\xEA j\xE1 entendeu o b\xE1isco da explora\xE7\xE3o.\n\nContinue
    procurando pistas para identificar o dinossauro que ser\xE1 encontrado e encontre
    equipamentos para desbloquear novas \xE1reas.\n\nSuas descobertas podem ser vistas
    na guia de Di\xE1rio de seu Tablet.\n\nBoa sorte, jovem explorador."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
