  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "F\xF3sseis de colora\xE7\xE3o mais clara, gra\xE7as ao n\xEDvel de c\xE1lcio
    na dieta. Formato mais alongado, cil\xEDndrico e com extremidades pontiagudas
    ou retorcidas\n\nExibem fragmentos vis\xEDveis de ossos, dentes, escamas e/ou
    peda\xE7os de carapa\xE7as que n\xE3o foram totalmente dissolvidos pelos \xE1cidos
    estomacais.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
